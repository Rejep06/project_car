# Машинно-зависимые параметры корневого docker-compose.yml.
# Сам .env находится в .gitignore, поэтому значения на ПК и сервере не
# перезаписываются при git pull.
DOCKER_RESTART_POLICY=unless-stopped
DOCKER_DNS_PRIMARY=1.1.1.1
DOCKER_DNS_SECONDARY=8.8.8.8

# Привязка портов к host. На production обычно оставляют 127.0.0.1 и
# публикуют сервисы через Nginx/Caddy.
POSTGRES_BIND_HOST=127.0.0.1
POSTGRES_PORT=5432
API_BIND_HOST=127.0.0.1
API_PORT=8000
CUSTOMER_FRONTEND_BIND_HOST=127.0.0.1
CUSTOMER_FRONTEND_PORT=3000
ADMIN_FRONTEND_BIND_HOST=127.0.0.1
ADMIN_FRONTEND_PORT=3001

# PostgreSQL для корневого docker-compose.yml.
# Эти значения должны совпадать с DATABASE_URL в backend/.env.
POSTGRES_DB=subscriptions
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Значения встраиваются во frontend во время docker compose build.
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_APP_NAME=Automotive Club
VITE_ADMIN_APP_NAME=Панель управления

# Для production измените логин/пароль PostgreSQL и обязательно укажите
# те же значения в DATABASE_URL файла backend/.env.
# VITE_API_BASE_URL=https://api.example.com/api/v1
