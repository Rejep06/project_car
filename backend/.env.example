APP_NAME=Automotive Club
APP_ENV=development
DEBUG=true
API_PREFIX=/api/v1
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
CUSTOMER_FRONTEND_URL=http://localhost:3000

DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/subscriptions

JWT_SECRET=change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# Подтверждение email и восстановление пароля.
# В development можно оставить false: API вернёт тестовый токен.
# В production обязательно true и рабочий SMTP.
EMAIL_DELIVERY_ENABLED=false
# Только hostname, без https:// и без :587.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Automotive Club
SMTP_STARTTLS=true
SMTP_USE_SSL=false
SMTP_TIMEOUT_SECONDS=30
EMAIL_VERIFICATION_TTL_HOURS=24
PASSWORD_RESET_TTL_MINUTES=60
EMAIL_REQUEST_COOLDOWN_SECONDS=60
EMAIL_WORKER_INTERVAL_SECONDS=10
EMAIL_WORKER_BATCH_SIZE=20
EMAIL_WORKER_MAX_ATTEMPTS=8

# Версии формы регистрации и документов. При любом изменении текста
# увеличьте соответствующую версию до публикации новой сборки.
REGISTRATION_CONSENT_FORM_VERSION=2026-08-10
TERMS_VERSION=2026-08-10
PRIVACY_POLICY_VERSION=2026-08-10
PERSONAL_DATA_PROCESSING_VERSION=2026-08-10
PROGRAM_RULES_VERSION=2026-08-10
AGE_CONFIRMATION_VERSION=2026-08-10

ASSET=USDT
ASSET_DECIMALS=6
NETWORK=ETHEREUM
NETWORK_DISPLAY_NAME=Ethereum (ERC-20)
DEFAULT_DEPOSIT_ADDRESS=

DEPOSIT_MONITORING_ENABLED=true
INFURA_API_KEY=
INFURA_JWT=
INFURA_RPC_URL=
INFURA_REQUEST_TIMEOUT_SECONDS=30

ETHEREUM_PROVIDER_NETWORK=mainnet
ETHEREUM_CHAIN_ID=1
ETHEREUM_USDT_CONTRACT_ADDRESS=0xdac17f958d2ee523a2206206994597c13d831ec7
ETHEREUM_USDT_DECIMALS=6
ETHEREUM_CONFIRMATIONS=12
# Новый проект начинает сканирование с текущего подтверждённого блока.
ETHEREUM_INITIAL_LOOKBACK_BLOCKS=0
ETHEREUM_REORG_LOOKBACK_BLOCKS=1
ETHEREUM_LOG_BLOCK_RANGE=1000
ETHEREUM_ADDRESS_BATCH_SIZE=50

MIN_DEPOSIT_AMOUNT=10.000000
DEPOSIT_INVOICE_TTL_MINUTES=30
DEPOSIT_AMOUNT_RESERVATION_HOURS=24
DEPOSIT_POLL_INTERVAL_SECONDS=300

MIN_WITHDRAWAL_AMOUNT=20.000000
WITHDRAWAL_FEE=2.000000
BUSINESS_TIMEZONE=Asia/Almaty
WITHDRAWAL_ALLOWED_WEEKDAY=2
WITHDRAWAL_PROCESSING_MIN_HOURS=1
WITHDRAWAL_PROCESSING_MAX_DAYS=3

REFERRAL_PURCHASE_BONUS_PERCENT=10
PREMIUM_REFERRAL_REWARD_BONUS=2.000000

REWARD_WORKER_INTERVAL_SECONDS=30
REWARD_WORKER_BATCH_SIZE=50

SUPPORT_UPLOAD_DIR=uploads/support
SUPPORT_MAX_FILE_SIZE_MB=5
SUPPORT_MAX_FILES_PER_MESSAGE=3

# Эти параметры читает только backend/docker-compose.yml при отдельном
# backend-only запуске. В полном стеке они задаются в корневом .env.
DOCKER_RESTART_POLICY=unless-stopped
DOCKER_DNS_PRIMARY=1.1.1.1
DOCKER_DNS_SECONDARY=8.8.8.8
POSTGRES_BIND_HOST=127.0.0.1
POSTGRES_PORT=5432
API_BIND_HOST=127.0.0.1
API_PORT=8000
