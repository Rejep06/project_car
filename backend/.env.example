APP_NAME=Subscription Platform
APP_ENV=development
DEBUG=true
API_PREFIX=/api/v1
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/subscriptions

JWT_SECRET=change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

ASSET=USDT
ASSET_DECIMALS=6
NETWORK=TRON
NETWORK_DISPLAY_NAME=TRON (TRC20)

BINANCE_API_BASE_URL=https://api.binance.com
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_DEPOSIT_ADDRESS=
BINANCE_ENABLED=true
BINANCE_REQUEST_TIMEOUT_SECONDS=15
BINANCE_LOOKBACK_HOURS=24

MIN_DEPOSIT_AMOUNT=10.000000
DEPOSIT_INVOICE_TTL_MINUTES=30
DEPOSIT_AMOUNT_RESERVATION_HOURS=24
DEPOSIT_POLL_INTERVAL_SECONDS=20

MIN_WITHDRAWAL_AMOUNT=20.000000
WITHDRAWAL_FEE=2.000000

REWARD_WORKER_INTERVAL_SECONDS=30
REWARD_WORKER_BATCH_SIZE=50

SUPPORT_UPLOAD_DIR=uploads/support
SUPPORT_MAX_FILE_SIZE_MB=5
SUPPORT_MAX_FILES_PER_MESSAGE=3
